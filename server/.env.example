# Your Garmin Connect login (the same one you use in the Garmin Connect app).
# Never commit the real .env file - it holds your actual password.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# Shared secret the frontend must send as "X-Api-Key" on every request.
# Generate one yourself, e.g.: openssl rand -hex 32
API_KEY=change-me

# Comma-separated list of origins allowed to call this API (your Pages URL).
ALLOWED_ORIGINS=https://7gw4tzvh9t-boop.github.io

PORT=3000
